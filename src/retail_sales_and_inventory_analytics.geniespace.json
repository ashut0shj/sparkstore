{
  "benchmarks": {
    "questions": [
      {
        "id": "01f1cde01ee81699bc2c02a334b19e01",
        "question": ["What was the total net sales revenue last month?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT SUM(net_sales_amount) AS total_net_sales FROM catalog.gold.fact_sales WHERE date_trunc('MONTH', transaction_date) = date_trunc('MONTH', add_months(current_date(), -1));"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e02",
        "question": ["Which sales region generated the highest gross profit?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT sales_region, total_gross_profit FROM catalog.gold.revenue_by_region ORDER BY total_gross_profit DESC LIMIT 1;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e03",
        "question": ["Show me profit by brand for the top 5 brands."],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT product_brand, total_gross_profit FROM catalog.gold.profit_by_brand ORDER BY total_gross_profit DESC LIMIT 5;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e04",
        "question": ["What is the return rate percentage for each month this year?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT sales_month, return_rate_pct FROM catalog.gold.returns_pct_by_month WHERE sales_month LIKE concat(year(current_date()), '-%') ORDER BY sales_month;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e05",
        "question": ["Which promotion drove the most net sales?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT promotion_name, total_net_sales FROM catalog.gold.revenue_by_promotion ORDER BY total_net_sales DESC LIMIT 1;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e06",
        "question": ["How much discount did we give out per promotion type?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT promotion_type, SUM(total_discount_given) AS total_discount_given FROM catalog.gold.revenue_by_promotion GROUP BY promotion_type ORDER BY total_discount_given DESC;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e07",
        "question": ["Break down net sales by customer loyalty tier."],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT member_card, total_net_sales FROM catalog.gold.sales_by_customer_tier ORDER BY total_net_sales DESC;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e08",
        "question": ["What was month-over-month sales growth for the last 6 months?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT sales_month, total_net_sales, growth_pct FROM catalog.gold.sales_growth_by_month ORDER BY sales_month DESC LIMIT 6;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e09",
        "question": ["Who are our top 10 customers by total spend?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT customer_id, total_net_sales FROM catalog.gold.customer_analytics ORDER BY total_net_sales DESC, customer_id ASC LIMIT 10;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e10",
        "question": ["What is the average transaction value for Golden member_card customers?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT AVG(avg_transaction_value) AS avg_txn_value FROM catalog.gold.customer_analytics WHERE member_card = 'Golden';"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e11",
        "question": ["Which customers haven't purchased in the last 90 days?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT customer_id, last_purchase_date FROM catalog.gold.customer_analytics WHERE last_purchase_date < date_sub(current_date(), 90) ORDER BY last_purchase_date ASC, customer_id ASC;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e12",
        "question": ["What's the total return value by product brand for this quarter?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT product_brand, SUM(total_return_value) AS total_return_value FROM catalog.gold.returns_analysis WHERE return_month LIKE concat(year(current_date()), '-%') GROUP BY product_brand ORDER BY total_return_value DESC;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e13",
        "question": ["Which store had the highest number of transactions last year?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT store_name, transaction_line_count FROM catalog.gold.sales_by_store ORDER BY transaction_line_count DESC, store_name ASC LIMIT 1;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e14",
        "question": ["List the top 10 products by total gross profit."],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT product_name, total_gross_profit FROM catalog.gold.top_products_by_revenue ORDER BY total_gross_profit DESC, product_name ASC LIMIT 10;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e15",
        "question": ["How does online order revenue compare to in-store sales for the same period?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT 'in_store' AS channel, SUM(net_sales_amount) AS total_net_sales FROM catalog.gold.fact_sales UNION ALL SELECT 'online' AS channel, SUM(net_sales_amount) AS total_net_sales FROM catalog.gold.fact_online_orders;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e16",
        "question": ["What's the margin percentage trend across quarters?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT c.calendar_quarter, c.calendar_year, AVG(f.margin_pct) AS avg_margin_pct FROM catalog.gold.fact_sales f JOIN catalog.gold.dim_calendar c ON f.transaction_date = c.calendar_date GROUP BY c.calendar_year, c.calendar_quarter ORDER BY c.calendar_year, c.calendar_quarter;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e17",
        "question": ["Compare net sales between weekdays and weekends."],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT CASE WHEN c.day_of_week IN ('Saturday', 'Sunday') THEN 'weekend' ELSE 'weekday' END AS day_type, SUM(f.net_sales_amount) AS total_net_sales FROM catalog.gold.fact_sales f JOIN catalog.gold.dim_calendar c ON f.transaction_date = c.calendar_date GROUP BY day_type;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e18",
        "question": ["What revenue came from a store's current location versus its prior remodeled version?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT s.store_id, s.store_name, s.__START_AT AS version_start, s.__END_AT AS version_end, SUM(f.net_sales_amount) AS total_net_sales FROM catalog.gold.fact_sales f JOIN catalog.gold.dim_store s ON f.store_id = s.store_id AND f.transaction_date >= s.__START_AT AND (s.__END_AT IS NULL OR f.transaction_date < s.__END_AT) GROUP BY s.store_id, s.store_name, s.__START_AT, s.__END_AT ORDER BY s.store_id, version_start;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e19",
        "question": ["What are the most recent inventory restock events by store?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT store_name, product_name, event_type, event_timestamp FROM catalog.gold.fact_inventory_events ORDER BY event_timestamp DESC LIMIT 20;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e20",
        "question": ["Which region has customers with the highest average transaction value?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT r.sales_region, AVG(f.net_sales_amount) AS avg_transaction_value FROM catalog.gold.fact_sales f JOIN catalog.gold.dim_store s ON f.store_id = s.store_id JOIN catalog.gold.dim_region r ON s.region_id = r.region_id GROUP BY r.sales_region ORDER BY avg_transaction_value DESC LIMIT 1;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e21",
        "question": ["What's total refund cost versus refund amount, to see our net loss on returns?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT SUM(refund_amount) AS total_refund_amount, SUM(refund_cost_amount) AS total_refund_cost, SUM(refund_amount) - SUM(refund_cost_amount) AS net_loss FROM catalog.gold.fact_returns;"]
          }
        ]
      },
      {
        "id": "01f1cde01ee81699bc2c02a334b19e22",
        "question": ["Break down profit by product category."],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT product_brand AS category_substitute, SUM(total_gross_profit) AS total_gross_profit FROM catalog.gold.profit_by_brand GROUP BY product_brand ORDER BY total_gross_profit DESC;"]
          }
        ]
      }
    ]
  },
