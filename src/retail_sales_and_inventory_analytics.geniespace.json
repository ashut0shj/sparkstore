{
  "benchmarks": {
    "questions": [
      {
        "id": "b01",
        "question": ["What is the monthly trend of total net sales in fact_sales?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT DATE_TRUNC('month', transaction_date) AS month, SUM(net_sales) AS total_net_sales FROM maven_test.retail.fact_sales GROUP BY 1 ORDER BY 1;"]
          }
        ]
      },
      {
        "id": "b02",
        "question": ["What are the top 5 stores by total sales revenue?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT s.store_name, SUM(f.net_sales) AS total_revenue FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_store s ON f.store_id = s.store_id GROUP BY s.store_name ORDER BY total_revenue DESC LIMIT 5;"]
          }
        ]
      },
      {
        "id": "b03",
        "question": ["What is the total quantity of items sold by product category?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT p.category, SUM(f.quantity) AS total_quantity FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_product p ON f.product_id = p.product_id GROUP BY p.category ORDER BY total_quantity DESC;"]
          }
        ]
      },
      {
        "id": "b04",
        "question": ["What is the total return amount across all transactions?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT SUM(return_amount) AS total_returns FROM maven_test.retail.fact_returns;"]
          }
        ]
      },
      {
        "id": "b05",
        "question": ["Which customer segment generates the highest total net sales?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT c.customer_segment, SUM(f.net_sales) AS total_sales FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_customer c ON f.customer_id = c.customer_id GROUP BY c.customer_segment ORDER BY total_sales DESC;"]
          }
        ]
      },
      {
        "id": "b06",
        "question": ["What is the average discount given per product category?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT p.category, AVG(f.discount_amount) AS avg_discount FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_product p ON f.product_id = p.product_id GROUP BY p.category;"]
          }
        ]
      },
      {
        "id": "b07",
        "question": ["How many unique customers made purchases in each store state?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT s.state, COUNT(DISTINCT f.customer_id) AS unique_customers FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_store s ON f.store_id = s.store_id GROUP BY s.state ORDER BY unique_customers DESC;"]
          }
        ]
      },
      {
        "id": "b08",
        "question": ["What is the monthly total inventory stock level?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT DATE_TRUNC('month', inventory_date) AS month, SUM(stock_on_hand) AS total_stock FROM maven_test.retail.fact_inventory GROUP BY 1 ORDER BY 1;"]
          }
        ]
      },
      {
        "id": "b09",
        "question": ["Which products have the lowest stock levels currently?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT p.product_name, i.stock_on_hand FROM maven_test.retail.fact_inventory i JOIN maven_test.retail.dim_product p ON i.product_id = p.product_id ORDER BY i.stock_on_hand ASC LIMIT 10;"]
          }
        ]
      },
      {
        "id": "b10",
        "question": ["What is the total sales breakdown by payment method?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT payment_method, SUM(net_sales) AS total_sales FROM maven_test.retail.fact_sales GROUP BY payment_method ORDER BY total_sales DESC;"]
          }
        ]
      },
      {
        "id": "b11",
        "question": ["What is the daily average net sales amount?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT transaction_date, AVG(net_sales) AS avg_daily_sales FROM maven_test.retail.fact_sales GROUP BY transaction_date ORDER BY transaction_date DESC;"]
          }
        ]
      },
      {
        "id": "b12",
        "question": ["Which store type has the highest average transaction value?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT s.store_type, AVG(f.net_sales) AS avg_transaction_value FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_store s ON f.store_id = s.store_id GROUP BY s.store_type ORDER BY avg_transaction_value DESC;"]
          }
        ]
      },
      {
        "id": "b13",
        "question": ["What is the total revenue generated by brand?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT p.brand, SUM(f.net_sales) AS total_revenue FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_product p ON f.product_id = p.product_id GROUP BY p.brand ORDER BY total_revenue DESC;"]
          }
        ]
      },
      {
        "id": "b14",
        "question": ["How many returns occurred per product category?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT p.category, COUNT(r.return_id) AS total_returns FROM maven_test.retail.fact_returns r JOIN maven_test.retail.dim_product p ON r.product_id = p.product_id GROUP BY p.category ORDER BY total_returns DESC;"]
          }
        ]
      },
      {
        "id": "b15",
        "question": ["What is the distribution of customer purchase counts across age groups?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT CASE WHEN c.age < 25 THEN 'Under 25' WHEN c.age BETWEEN 25 AND 40 THEN '25-40' WHEN c.age BETWEEN 41 AND 60 THEN '41-60' ELSE '60+' END AS age_group, COUNT(f.sale_id) AS purchase_count FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_customer c ON f.customer_id = c.customer_id GROUP BY 1;"]
          }
        ]
      },
      {
        "id": "b16",
        "question": ["What are the top 10 highest-priced products?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT product_name, unit_price FROM maven_test.retail.dim_product ORDER BY unit_price DESC LIMIT 10;"]
          }
        ]
      },
      {
        "id": "b17",
        "question": ["What is the total profit margin sum grouped by store city?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT s.city, SUM(f.profit_amount) AS total_profit FROM maven_test.retail.fact_sales f JOIN maven_test.retail.dim_store s ON f.store_id = s.store_id GROUP BY s.city ORDER BY total_profit DESC;"]
          }
        ]
      },
      {
        "id": "b18",
        "question": ["Which months record the highest overall return counts?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT DATE_TRUNC('month', return_date) AS month, COUNT(*) AS return_count FROM maven_test.retail.fact_returns GROUP BY 1 ORDER BY return_count DESC;"]
          }
        ]
      },
      {
        "id": "b19",
        "question": ["What is the total count of active stores by country and state?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT country, state, COUNT(*) AS store_count FROM maven_test.retail.dim_store GROUP BY country, state ORDER BY store_count DESC;"]
          }
        ]
      },
      {
        "id": "b20",
        "question": ["What is the overall average margin percentage across all sales?"],
        "answer": [
          {
            "format": "SQL",
            "content": ["SELECT AVG(margin_percentage) AS avg_margin_pct FROM maven_test.retail.fact_sales;"]
          }
        ]
      }
    ]
  },
