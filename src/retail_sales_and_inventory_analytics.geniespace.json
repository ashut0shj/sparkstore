  "instructions": {
    "example_question_sqls": [
      {
        "id": "01f1cd7883df11a38a6dfeb96c3a9533",
        "question": [
          "What was total revenue by region ?"
        ],
        "sql": [
          "SELECT sales_region, total_net_sales, total_gross_profit\r\n",
          "FROM maven_test.gold.revenue_by_region\r\n",
          "ORDER BY total_net_sales DESC;"
        ]
      },
      {
        "id": "01f1cd7897bf1b3a90089021d6ee4436",
        "question": [
          "What was total products by revenue ?"
        ],
        "sql": [
          "SELECT product_name, product_brand, total_net_sales, total_gross_profit\r\n",
          "FROM maven_test.gold.top_products_by_revenue\r\n",
          "ORDER BY total_net_sales DESC LIMIT 10;"
        ]
      },
      {
        "id": "01f1cd78ea21136ebed6142940b874bc",
        "question": [
          "What is the return rate trend by month ?"
        ],
        "sql": [
          "SELECT sales_month, return_rate_pct\r\n",
          "FROM maven_test.gold.returns_pct_by_month\r\n",
          "ORDER BY sales_month;"
        ]
      },
      {
        "id": "01f1cd790544113c92e58635687a9e34",
        "question": [
          "What is the sales by customer loyalty tier ?"
        ],
        "sql": [
          "SELECT member_card, total_net_sales\r\n",
          "FROM maven_test.gold.sales_by_customer_tier\r\n",
          "ORDER BY total_net_sales DESC;"
        ]
      },
      {
        "id": "01f1cd79155b1a48b38af01c9fa1cc1f",
        "question": [
          "What is the store performance ?"
        ],
        "sql": [
          "SELECT store_name, sales_region, store_country, total_net_sales, margin_pct\r\n",
          "FROM maven_test.gold.sales_by_store\r\n",
          "ORDER BY total_net_sales DESC;"
        ]
      }
    ],
    "text_instructions": [
      {
        "content": [
          "- \"Net sales\" means net_sales_amount, not gross_sales_amount.\r\n",
          "- \"Margin %\" = gross_profit_amount / net_sales_amount * 100.\r\n",
          "- \"Region\" refers to sales_region (6 named regions). \"Country\" refers to\r\n",
          "  store_country (United States/Mexico/Canada). These are independent —\r\n",
          "  a region can contain stores from more than one country. Never treat\r\n",
          "  \"region\" and \"country\" as the same filter.\r\n",
          "- Prefer the summary tables (revenue_by_region, sales_by_store,\r\n",
          "  top_products_by_revenue, etc.) over querying fact_sales/fact_returns\r\n",
          "  directly when the question is about totals or rankings — they're\r\n",
          "  pre-aggregated and faster.\r\n",
          "- fact_online_orders is the digital/streaming channel and has no store_id\r\n",
          "  — don't try to join it to dim_store.\r\n",
          "- \"Return rate\" = refund_amount / net_sales_amount * 100 for the same\r\n",
          "  period, from returns_pct_by_month."
        ],
        "id": "01f1cd7846361c61a30b9ccbac423205"
      }
    ]
  },
